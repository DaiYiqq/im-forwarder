# Normalize line endings: repository stores LF, checkouts on Windows also get LF.
* text=auto eol=lf

# Windows batch scripts must stay CRLF (cmd.exe is unreliable with LF-only .bat/.cmd).
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary / generated assets
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.jar binary
*.7z binary

# Do not diff lockfiles (still tracked, just not displayed in diffs by default)
package-lock.json -diff
